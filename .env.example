# MangaHive does not read this file directly in the GitHub Pages build.
# These values correspond to GitHub Actions repository secrets.
MANGAHIVE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
MANGAHIVE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
MANGAHIVE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
