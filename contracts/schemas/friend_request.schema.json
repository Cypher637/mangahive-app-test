{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangahive.app/contracts/friend_request.schema.json",
  "title": "FriendRequest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "requester_id": {
      "type": "string"
    },
    "addressee_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "requester_id",
    "addressee_id",
    "status"
  ],
  "additionalProperties": true
}
