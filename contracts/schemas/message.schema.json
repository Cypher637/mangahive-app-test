{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangahive.app/contracts/message.schema.json",
  "title": "Message",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "user_id",
    "body"
  ],
  "additionalProperties": true
}
