{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangahive.app/schemas/extension-manifest-v1.json",
  "title": "MangaHive Extension Manifest",
  "type": "object",
  "required": ["id", "name", "version", "apiVersion", "sources"],
  "properties": {
    "manifestVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*\\.[a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "apiVersion": { "type": "integer", "const": 1 },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "enum": ["network", "storage"] }
    },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
          "name": { "type": "string" },
          "capabilities": {},
          "engine": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["static-catalog", "rest"] }
            }
          }
        }
      }
    },
    "signature": { "type": ["string", "null"] },
    "signingKeyId": { "type": ["string", "null"] }
  }
}
