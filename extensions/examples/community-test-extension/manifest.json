        "search",
        "details",
        "chapters",
        "pages"
      ],
      "engine": {
        "type": "static-catalog",
        "catalog": [
          {
            "remoteId": "test-one",
            "title": "MangaHive Extension Probe",
            "chapters": [
              {
                "remoteId": "c1",
                "title": "Chapter 1",
                "chapter": 1,
                "pages": [
                  "https://via.placeholder.com/600x900.png?text=MH+Test+Page+1",
                  "https://via.placeholder.com/600x900.png?text=MH+Test+Page+2"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "signature": null,
  "signingKeyId": null
}