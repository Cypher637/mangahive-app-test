{
  "manifestVersion": 1,
  "id": "community.test-extension",
  "name": "MangaHive Test Extension",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "MangaHive",
  "description": "Harmless static-catalog extension proving dynamic source registration.",
  "license": "MIT",
  "permissions": [
    "network",
    "storage"
  ],
  "capabilities": [
    "search",
    "details",
    "chapters",
    "pages"
  ],
  "contentTypes": [
    "manga"
  ],
  "languages": [
    "en"
  ],
  "sources": [
    {
      "id": "mh-test-source",
      "name": "MH Test Source",
